<?php
/**
 * Quantity with − / + buttons next to the Add to Cart button.
 *
 * @var $block \Magento\Catalog\Block\Product\View
 * @var \Magento\Framework\Escaper $escaper
 */
?>
<?php $_product = $block->getProduct(); ?>
<?php $buttonTitle = __('Add to Cart'); ?>
<?php if ($_product->isSaleable()): ?>
<div class="box-tocart">
    <?php if ($block->shouldRenderQuantity()): ?>
        <label class="pdp-qty-label" for="qty"><?= $escaper->escapeHtml(__('Quantity')) ?></label>
    <?php endif; ?>
    <div class="fieldset">
        <?php if ($block->shouldRenderQuantity()): ?>
        <div class="field qty">
            <div class="control pdp-qty" data-mage-init='{"Codilar_ProductPage/js/qty-stepper": {"min": 1}}'>
                <button type="button" class="pdp-qty__btn" data-role="qty-step" data-step="-1"
                        aria-label="<?= $escaper->escapeHtmlAttr(__('Decrease quantity')) ?>">&minus;</button>
                <input type="number"
                       name="qty"
                       id="qty"
                       min="0"
                       value="<?= $block->getProductDefaultQty() * 1 ?>"
                       title="<?= $escaper->escapeHtmlAttr(__('Qty')) ?>"
                       class="input-text qty"
                       data-validate="<?= $escaper->escapeHtml(json_encode($block->getQuantityValidators())) ?>"
                       />
                <button type="button" class="pdp-qty__btn" data-role="qty-step" data-step="1"
                        aria-label="<?= $escaper->escapeHtmlAttr(__('Increase quantity')) ?>">+</button>
            </div>
        </div>
        <?php endif; ?>
        <div class="actions">
            <button type="submit"
                    title="<?= $escaper->escapeHtmlAttr($buttonTitle) ?>"
                    class="action primary tocart"
                    id="product-addtocart-button" disabled>
                <span><?= $escaper->escapeHtml($buttonTitle) ?></span>
            </button>
            <?= $block->getChildHtml('', true) ?>
        </div>
    </div>
</div>
<?php endif; ?>
<script type="text/x-magento-init">
    {
        "#product_addtocart_form": {
            "Magento_Catalog/js/validate-product": {}
        }
    }
</script>
