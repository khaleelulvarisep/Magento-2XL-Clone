<?php
/**
 * Product details as an accordion (Product Description, Specifications, Care, Shipping, Reviews)
 * instead of Luma's tabs.
 *
 * @var \Magento\Catalog\Block\Product\View\Details $block
 * @var \Magento\Framework\Escaper $escaper
 */
?>
<?php if ($detailedInfoGroup = $block->getGroupSortedChildNames('detailed_info', 'getChildHtml')): ?>
    <div class="pdp-details" data-mage-init='{"Codilar_ProductPage/js/details-accordion": {}}'>
        <?php $layout = $block->getLayout(); ?>
        <?php $isFirst = true; ?>
        <?php foreach ($detailedInfoGroup as $name): ?>
            <?php
            $html = $layout->renderElement($name);
            if (!$html || !trim($html)) {
                continue;
            }
            $alias = $layout->getElementAlias($name);
            $label = $block->getChildData($alias, 'title');
            ?>
            <div class="pdp-details__title<?= $isFirst ? ' active' : '' ?>"
                 data-role="collapsible" id="tab-label-<?= $escaper->escapeHtmlAttr($alias) ?>">
                <a class="pdp-details__switch"
                   data-toggle="trigger"
                   href="#<?= $escaper->escapeHtmlAttr($alias) ?>"
                   id="tab-label-<?= $escaper->escapeHtmlAttr($alias) ?>-title">
                    <?= /* @noEscape */ $label ?>
                </a>
            </div>
            <div class="pdp-details__content"
                 aria-labelledby="tab-label-<?= $escaper->escapeHtmlAttr($alias) ?>-title"
                 id="<?= $escaper->escapeHtmlAttr($alias) ?>" data-role="content">
                <?= /* @noEscape */ $html ?>
            </div>
            <?php $isFirst = false; ?>
        <?php endforeach; ?>
    </div>
<?php endif; ?>
