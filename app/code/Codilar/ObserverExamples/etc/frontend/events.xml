<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!--
        Core Magento events, listened to on the storefront only (etc/frontend/).
        Magento dispatches these itself; we just subscribe, nothing in the core code changes.
    -->

    <!-- Dispatched by Checkout\Model\Cart::addProduct() after a product lands in the cart -->
    <event name="checkout_cart_product_add_after">
        <observer name="codilar_low_stock_notice" instance="Codilar\ObserverExamples\Observer\LowStockNoticeOnAddToCart"/>
    </event>

    <!-- Dispatched by Customer\Model\Session when a customer logs in -->
    <event name="customer_login">
        <observer name="codilar_welcome_back" instance="Codilar\ObserverExamples\Observer\WelcomeBackMessage"/>
    </event>
</config>
