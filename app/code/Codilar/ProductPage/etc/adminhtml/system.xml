<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="codilar" translate="label" sortOrder="900">
            <label>Codilar</label>
        </tab>
        <section id="codilar_pdp" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Product Page</label>
            <tab>codilar</tab>
            <resource>Codilar_ProductPage::config</resource>
            <group id="points" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Reward Points</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show Points</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="rate" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Points per 1 Unit of Currency</label>
                    <validate>validate-number validate-zero-or-greater</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>
            <group id="installments" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Pay Later Boxes and Popups (Tabby / Tamara look, display only)</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show Pay Later Boxes</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="tabby" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show Tabby Box</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="tamara" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show Tamara Box</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>
            <group id="warehouse" translate="label" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Warehouse Pickup</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show Warehouse Pickup Box</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="learn_more_url" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Learn More URL</label>
                    <comment>Relative path (e.g. a CMS page URL key) or a full URL.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>
            <group id="shipping" translate="label" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Shipping and Returns</label>
                <field id="text" translate="label" type="textarea" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Text</label>
                </field>
                <field id="learn_more_url" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Learn More URL</label>
                    <comment>Relative path (e.g. a CMS page URL key) or a full URL.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
