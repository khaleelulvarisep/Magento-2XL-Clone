        </span>
        <div>
            <p class="tabby-popup__feature-title"><?= $escaper->escapeHtml(__('Shop safely with Tabby')) ?></p>
            <p class="tabby-popup__feature-text"><?= $escaper->escapeHtml(__('Buyer protection is included with every purchase')) ?></p>
        </div>
    </div>

    <button type="button" class="tabby-popup__continue" data-bnpl-close><?= $escaper->escapeHtml(__('Continue shopping')) ?></button>
    <img class="bnpl-popup__cards" src="<?= /* @noEscape */ $image('tabby-cards.png') ?>" alt="<?= $escaper->escapeHtmlAttr(__('Mastercard, Visa, Apple Pay, Google Pay')) ?>" width="174" height="29">
