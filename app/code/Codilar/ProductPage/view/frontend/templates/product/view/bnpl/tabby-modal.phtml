            <p class="tabby-popup__feature-title"><?= $escaper->escapeHtml(__('Trusted by millions')) ?></p>
            <p class="tabby-popup__feature-text"><?= $escaper->escapeHtml(__('Over 20 million shoppers discover products and pay their way with Tabby')) ?></p>
